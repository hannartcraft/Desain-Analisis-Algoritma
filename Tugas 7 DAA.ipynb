import itertools

def calculate_distance(points):
    distance = 0
    for i in range(len(points) - 1):
        distance += ((points[i][0] - points[i+1][0]) ** 2 + (points[i][1] - points[i+1][1]) ** 2) ** 0.5
    distance += ((points[-1][0] - points[0][0]) ** 2 + (points[-1][1] - points[0][1]) ** 2) ** 0.5  # Kembali ke titik awal
    return distance

def tsp_brute_force(points):
    min_path = None
    min_distance = float('inf')

    for perm in itertools.permutations(points):
        current_distance = calculate_distance(perm)
        if current_distance < min_distance:
            min_distance = current_distance
            min_path = perm

    return min_path, min_distance

# Contoh penggunaan
points = [(0, 0), (1, 1), (1, 0), (0, 1)]
best_path, best_distance = tsp_brute_force(points)
print("Best Path (Brute Force):", best_path)
print("Best Distance (Brute Force):", best_distance)

Greedy TSP

def tsp_greedy(points):
    start = points[0]
    visited = [start]
    current_point = start

    while len(visited) < len(points):
        next_point = None
        min_distance = float('inf')

        for point in points:
            if point not in visited:
                distance = ((current_point[0] - point[0]) ** 2 + (current_point[1] - point[1]) ** 2) ** 0.5
                if distance < min_distance:
                    min_distance = distance
                    next_point = point

        visited.append(next_point)
        current_point = next_point

    # Kembali ke titik awal
    visited.append(start)
    total_distance = calculate_distance(visited)

    return visited, total_distance

# Contoh penggunaan
points = [(0, 0), (1, 1), (1, 0), (0, 1)]
best_path_greedy, best_distance_greedy = tsp_greedy(points)
print("Best Path (Greedy):", best_path_greedy)
print("Best Distance (Greedy):", best_distance_greedy)
