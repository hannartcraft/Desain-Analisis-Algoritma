def find_all_patterns(text, pattern):
    index = 0
    results = []

    while index < len(text):
        index = text.find(pattern, index)
        if index == -1:
            break
        results.append(index)
        index += 1  # Maju satu karakter untuk mencari kemunculan berikutnya

    return results

