from itertools import permutations

distances = {
    ('A', 'B'): 10, ('A', 'C'): 15, ('A', 'D'): 20,
    ('B', 'C'): 35, ('B', 'D'): 25,
    ('C', 'D'): 30
}

def calculate_distance(tour):
    distance = 0
    for i in range(len(tour) - 1):
        distance += distances.get((tour[i], tour[i+1]), 0)
    distance += distances.get((tour[-1], tour[0]), 0)  # Return to start
    return distance

def tsp_brute_force(cities):
    shortest_tour = None
    min_distance = float('inf')

    for tour in permutations(cities):
        distance = calculate_distance(tour)
        if distance < min_distance:
            min_distance = distance
            shortest_tour = tour

    return shortest_tour, min_distance

cities = ['A', 'B', 'C', 'D']
shortest_tour, min_distance = tsp_brute_force(cities)
print(f"Shortest tour: {shortest_tour} with distance {min_distance}")
